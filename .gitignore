# -----------------------------------------------------------------------------
# pim-analysis 特有:全部运行时数据
# -----------------------------------------------------------------------------
# ⚠️ data/rtd/cookies.json 含 CF_Authorization 凭据,绝对不能入库
# data/blob/*.zip 几百 MB 整机测试压缩包
# data/raw/*/*.json.gz 真实产线序列号的测试数据
# data/server.log* 日志
# data/serials.json 内部序列号清单,降级候选用,保守 ignore(Linux 侧按需要自建)
data/

