# 复制为 linux.env，chmod 600；不要提交真实凭据。
PIM_AUTH_USER=pim-user
PIM_AUTH_PASS=REPLACE_WITH_A_RANDOM_PASSWORD
PIM_MI_AUTH=kerberos
PIM_ALLOW_RTD_REFRESH=0
PIM_BIND_HOST=127.0.0.1
PIM_PORT=8000
# API、refresh_cookies.py 必须使用一致的路径，并以同一个 OS 用户运行。
PIM_RTD_COOKIES=/opt/pim/data/rtd/cookies.json
PIM_RTD_TEMPLATES=/opt/pim/data/rtd/templates.json
PIM_RTD_PROFILE=/opt/pim/data/rtd/browser-profile
PIM_RTD_BROWSER=chromium
KRB5CCNAME=FILE:/opt/pim/data/krb5cc
